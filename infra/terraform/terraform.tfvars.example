location                    = "eastasia"
project_name                = "sysgap"
container_image             = "YOUR_REGISTRY.azurecr.io/sysgap-api:latest"
container_registry_server   = "YOUR_REGISTRY.azurecr.io"
container_registry_username = "YOUR_ACR_USERNAME"
container_registry_password = "YOUR_ACR_PASSWORD"
frontend_api_url            = "https://YOUR_API_HOST.azurecontainerapps.io"
allowed_frontend_origins    = "https://YOUR_STATIC_WEB_APP.azurestaticapps.net"
frontend_custom_domain      = ""